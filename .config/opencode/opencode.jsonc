{
  "$schema": "https://opencode.ai/config.json",
  "theme": "zenwritten-dark",
  "autoupdate": false,
  "share": "disabled",
  "disabled_providers": ["github-copilot", "github-models"],
  "watcher": {
    "ignore": [
      ".git/**",
      "**/node_modules/**",
      "**/.devenv/**",
      "**/__pycache__/**",
      "result/**",
    ],
  },
  "plugin": [
    "opencode-toolbox@0.10.4",
    "./plugins/hyprland/hyprland.ts",
    "./plugins/direnv/direnv-session-env.ts",
    "./plugins/ado-fetch/ado-fetch.ts",
    "./plugins/opencode-handoff/handoff.ts",
    "./plugins/openai-account-selector/openai-account-selector.ts",
  ],
  "instructions": [
    "~/.config/opencode/instructions/orchestration.md",
    "~/.config/opencode/instructions/code-search.md",
    "~/.config/opencode/instructions/worktrunk.md",
  ],
  "mcp": {
    "fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "enabled": true,
    },
    "neovim": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "exec env NVIM_CONTEXT_SOCKET=\"$OPENCODE_NVIM_SOCKET\" bun \"$HOME/.config/opencode/mcp/neovim/neovim-context.ts\"",
      ],
      "enabled": true,
    },
    "shared-todo": {
      "type": "remote",
      "url": "http://192.168.1.46:8092/mcp",
      "enabled": true,
    },
    "ai_pointer_exa": {
      "type": "local",
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}",
      },
      "command": [
        "podman",
        "run",
        "-i",
        "--rm",
        "--read-only",
        "--replace",
        "--name",
        "mcp-exa-ai-pointer",
        "-e",
        "EXA_API_KEY",
        "mcp/exa",
      ],
      "enabled": true,
    },
  },
  "tools": {
    "ai_pointer_exa_*": false,
  },
  "permission": {
    "external_directory": {
      "/tmp/*": "allow",
      "~/.config/opencode/**": "allow",
      "/Users/fbb/.config/opencode/**": "allow",
      "/home/fbb/**": "allow",
      "/nix/store/**": "allow",
      "/dev/shm/opencode-window-screenshots/": "allow",
    },
    "bash": {
      "rm *": "ask",
      "sudo *": "deny",
      "chmod *": "ask",
      "chmod +x *": "allow",
      "chown *": "ask",
      "git push*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git rm *": "ask",
      "git reset*": "ask",
      "git rebase*": "ask",
      "git worktree*": "ask",
      "git worktree list*": "allow",
      "git worktree prune --dry-run*": "allow",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git clean*": "ask",
      "git restore*": "ask",
      "gh api*": "allow",
      "gh api * --method DELETE*": "ask",
      "gh api * --method=DELETE*": "ask",
      "gh api * -X DELETE*": "ask",
      "gh api * -XDELETE*": "ask",
    },
  },
  "model": "openai/gpt-5.6-luna-fast",
  "small_model": "openai/gpt-5.6-luna-fast",
  "agent": {
    "build": {
      "color": "#6099C0",
      "prompt": "{file:./prompts/build.txt}",
      "temperature": 0.3,
      "reasoningEffort": "xhigh",
    },
    "desktop-pointer": {
      "description": "Answers questions about explicitly reviewed desktop captures with optional read-only web lookup.",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:../ags/components/ai-pointer/desktop-pointer-prompt.txt}",
      "tools": {
        "*": false,
        "ai_pointer_exa_web_search_exa": true,
        "webfetch": true,
        "websearch": true,
      },
      "model": "openai/gpt-5.6-luna-fast",
      "reasoningEffort": "low",
    },
    "plan": {
      "color": "#B279A7",
      "temperature": 0.2,
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
    },
    "backlog-planning": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
    },
    "explore": {
      "temperature": 0,
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "low",
    },
    "general": {
      "steps": 15,
      "prompt": "{file:./prompts/general.txt}",
      "temperature": 0.3,
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
    },
    "title": {
      "temperature": 0,
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "none",
      "textVerbosity": "low",
    },
    "summary": {
      "temperature": 0.1,
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "medium",
    },
    "compaction": {
      "temperature": 0,
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "medium",
    },
    "test": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
    },
    "review": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
    },
    "docs": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
    },
    "research": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
    },
    "lookup": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "low",
    },
    "quick": {
      "model": "openai/gpt-5.6-luna-fast",
      "reasoningEffort": "low",
      "textVerbosity": "low",
    },
    "validate": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "low",
    },
    "benchmark": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
    },
    "spec": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
    },
    "analyze": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
    },
    "debug": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
    },
    "pr-feedback": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
    },
    "ideate": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
    },
    "patterns": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "medium",
    },
    "adversarial": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
    },
    "refactor": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
    },
    "commit": {
      "model": "openai/gpt-5.6-luna-fast",
      "reasoningEffort": "none",
      "textVerbosity": "low",
    },
    "tutor": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
    },
  },
}
