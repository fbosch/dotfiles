{
  "$schema": "https://opencode.ai/config.json",
  "theme": "zenwritten-dark",
  "autoupdate": false,
  "disabled_providers": [
    "github-copilot",
    "github-models"
  ],
  "watcher": {
    "ignore": [
      ".git/**",
      "**/node_modules/**",
      "**/.devenv/**",
      "**/__pycache__/**",
      "result/**"
    ]
  },
  "plugin": [
    "opencode-toolbox@0.10.4",
    "./plugins/hyprland/hyprland.ts",
    "./plugins/direnv/direnv-session-env.ts",
    "./plugins/ado-fetch/ado-fetch.ts",
    "./plugins/neovim-herdr-agent/neovim-herdr-agent.ts",
    "./plugins/opencode-handoff/handoff.ts"
  ],
  "instructions": [
    "~/.config/opencode/instructions/orchestration.md",
    "~/.config/opencode/instructions/code-search.md",
    "~/.config/opencode/instructions/worktrunk.md"
  ],
  "mcp": {
    "fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "enabled": true
    },
    "neovim": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "exec env NVIM_CONTEXT_SOCKET=\"$OPENCODE_NVIM_SOCKET\" bun \"$HOME/.config/opencode/mcp/neovim/neovim-context.ts\""
      ],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/*": "allow",
      "~/.config/opencode/**": "allow",
      "/Users/fbb/.config/opencode/**": "allow",
      "/home/fbb/**": "allow",
      "/nix/store/**": "allow",
      "/dev/shm/opencode-window-screenshots/": "allow"
    },
    "bash": {
      "rm *": "ask",
      "sudo *": "deny",
      "chmod *": "ask",
      "chmod +x *": "allow",
      "chown *": "ask",
      "git push*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git rm *": "ask",
      "git reset*": "ask",
      "git rebase*": "ask",
      "git worktree*": "ask",
      "git worktree list*": "allow",
      "git worktree prune --dry-run*": "allow",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git clean*": "ask",
      "git restore*": "ask",
      "gh api*": "allow",
      "gh api * --method DELETE*": "ask",
      "gh api * --method=DELETE*": "ask",
      "gh api * -X DELETE*": "ask",
      "gh api * -XDELETE*": "ask",
    }
  },
  "model": "openai/gpt-5.6-terra-fast",
  "small_model": "openai/gpt-5.4-mini-fast",
  "agent": {
    "build": {
      "color": "#6099C0",
      "temperature": 0.3
    },
    "plan": {
      "color": "#B279A7",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "backlog-planning": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "explore": {
      "temperature": 0,
      "model": "openai/gpt-5.4-mini-fast",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "general": {
      "steps": 15,
      "temperature": 0.3,
      "model": "openai/gpt-5.6-terra-fast",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "title": {
      "temperature": 0,
      "model": "openai/gpt-5.4-mini",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "summary": {
      "temperature": 0.1,
      "model": "openai/gpt-5.4-mini",
      "reasoningEffort": "low",
      "textVerbosity": "medium"
    },
    "compaction": {
      "temperature": 0,
      "model": "openai/gpt-5.6-luna-fast",
      "reasoningEffort": "low",
      "textVerbosity": "medium"
    },
    "test": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "review": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "docs": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "research": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "lookup": {},
    "quick": {
      "model": "openai/gpt-5.6-luna-fast",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "validate": {
      "model": "openai/gpt-5.6-luna-fast",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "benchmark": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "spec": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "analyze": {
      "model": "openai/gpt-5.6-terra-fast",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "debug": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "pr-feedback": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "ideate": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "patterns": {
      "model": "openai/gpt-5.4-mini-fast",
      "reasoningEffort": "low",
      "textVerbosity": "medium"
    },
    "adversarial": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "refactor": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "commit": {
      "model": "openai/gpt-5.4-mini-fast",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    }
  }
}
