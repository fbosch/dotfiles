[
  {
    "plugin_id": "neovim-sessions",
    "name": "Neovim sessions",
    "version": "0.1.0",
    "min_herdr_version": "0.7.0",
    "description": "Restores pane-specific Neovim and OpenCode sessions.",
    "manifest_path": "/Users/fbb/dotfiles/.config/herdr/plugins/neovim-sessions/herdr-plugin.toml",
    "plugin_root": "/Users/fbb/dotfiles/.config/herdr/plugins/neovim-sessions",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "startup": [
      {
        "command": [
          "bash",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/scripts/restore.sh\""
        ]
      }
    ],
    "actions": [
      {
        "id": "migrate-pane",
        "title": "Migrate pane to Neovim session",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/scripts/migrate-pane.sh\""
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  },
  {
    "plugin_id": "worktrunk-lifecycle",
    "name": "Worktrunk lifecycle",
    "version": "0.1.0",
    "min_herdr_version": "0.7.0",
    "description": "Runs compatible Worktrunk post-lifecycle hooks for native Herdr worktrees.",
    "manifest_path": "/Users/fbb/dotfiles/.config/herdr/plugins/worktrunk-lifecycle/herdr-plugin.toml",
    "plugin_root": "/Users/fbb/dotfiles/.config/herdr/plugins/worktrunk-lifecycle",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "events": [
      {
        "on": "worktree.created",
        "command": [
          "bash",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/scripts/run-hook.sh\" pre-start"
        ]
      },
      {
        "on": "worktree.removed",
        "command": [
          "bash",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/scripts/run-hook.sh\" post-remove"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  }
]