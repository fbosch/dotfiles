#!/usr/bin/env sh

command=$1
fbb_dir=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd) || exit 1
bun --cwd "$fbb_dir" "lib/opencode-multi-auth/index.ts" "$@"
status=$?

if [ "$status" -eq 0 ] && { [ "$command" = switch ] || [ "$command" = login ]; }; then
    if { [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; } && command -v base64 >/dev/null 2>&1; then
        value=$(date +%s)
        encoded=$(printf %s "$value" | base64 | tr -d '\n')
        if [ -n "$TMUX" ]; then
            printf '\033Ptmux;\033\033]1337;SetUserVar=codex_profile_changed=%s\007\033\\' "$encoded" >/dev/tty 2>/dev/null
        else
            printf '\033]1337;SetUserVar=codex_profile_changed=%s\007' "$encoded" >/dev/tty 2>/dev/null
        fi
    fi
fi

exit "$status"
