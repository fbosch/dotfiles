{
	"entry": ["config-bundled.tsx"],
	"ignorePatterns": ["services/recent-applications.ts"],
	"ignoreDependencies": ["ags"],
	"ignoreExports": [
		{
			"file": "services/app-icons.ts",
			"exports": ["isGenericWrapperClass"]
		},
		{
			"file": "services/hyprland-ipc.ts",
			"exports": ["getHyprlandSocketPath"]
		}
	],
	"rules": {
		"unused-files": "warn",
		"unused-exports": "warn",
		"unlisted-dependencies": "warn"
	}
}
