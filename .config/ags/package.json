{
  "name": "ags-config",
  "version": "1.0.0",
  "description": "AGS (Aylur's GTK Shell) configuration for Hyprland",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "ags types",
    "start": "ags run config-bundled.tsx",
    "dev": "ags run config-bundled.tsx",
    "types": "ags types",
    "bundle": "ags bundle config-bundled.tsx \"${XDG_RUNTIME_DIR:-/tmp}/ags-bundled.js\"",
    "inspect": "ags inspect",
    "list": "ags list",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir /tmp/ags-coverage",
    "test:coverage:istanbul": "pnpm test:coverage && bun run scripts/lcov-to-istanbul.ts /tmp/ags-coverage/lcov.info /tmp/ags-coverage/coverage-final.json",
    "health:coverage": "pnpm test:coverage:istanbul && fallow health --coverage /tmp/ags-coverage/coverage-final.json --report-only",
    "benchmark": "bash scripts/benchmark/run-benchmarks.sh",
    "quality": "fallow --only dead-code --regression-baseline .fallow-regression-baseline.json --fail-on-regression"
  },
  "keywords": [
    "ags",
    "hyprland",
    "gtk",
    "wayland"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "fallow": "3.14.0",
    "typescript": "5.9.3"
  }
}
