{
  "name": "ags-config",
  "version": "1.0.0",
  "description": "AGS (Aylur's GTK Shell) configuration for Hyprland",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "ags types",
    "start": "ags run config-bundled.tsx",
    "dev": "ags run config-bundled.tsx",
    "types": "ags types",
    "bundle": "ags bundle config-bundled.tsx \"${XDG_RUNTIME_DIR:-/tmp}/ags-bundled.js\" && ags bundle --gtk 4 components/ai-pointer/accessibility/helper.ts \"${XDG_RUNTIME_DIR:-/tmp}/ags-ai-pointer-accessibility-helper\"",
    "inspect": "ags inspect",
    "list": "ags list",
    "test": "bun test && pnpm test:gjs",
    "test:gjs": "ags run --gtk 4 scripts/tests/gjs/run.ts",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir /tmp/ags-coverage && pnpm test:coverage:gjs",
    "test:coverage:gjs": "bash scripts/tests/gjs/coverage.sh",
    "test:coverage:istanbul": "pnpm test:coverage && bun run scripts/lcov-to-istanbul.ts /tmp/ags-coverage/lcov.info /tmp/ags-coverage/coverage-final.json",
    "health:coverage": "pnpm test:coverage:istanbul && fallow health --coverage /tmp/ags-coverage/coverage-final.json --report-only",
    "lint:lines": "biome lint .",
    "lint:styles": "stylelint \"{components,styles}/**/*.scss\"",
    "benchmark": "bash scripts/benchmark/run-benchmarks.sh",
    "benchmark:ai-pointer": "bun run components/ai-pointer/__benchmarks__/policy.ts && ags run --gtk 4 components/ai-pointer/__benchmarks__/controller.ts",
    "benchmark:ai-pointer:live": "bun run components/ai-pointer/__benchmarks__/live-collector.ts",
    "quality": "pnpm lint:lines && pnpm lint:styles && fallow --only dead-code --regression-baseline .fallow-regression-baseline.json --fail-on-regression"
  },
  "keywords": [
    "ags",
    "hyprland",
    "gtk",
    "wayland"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "fallow": "3.14.0",
    "postcss": "8.5.26",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ts-pattern": "^5.9.0",
    "xstate": "5.32.5"
  }
}
