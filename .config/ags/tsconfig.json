{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "allowImportingTsExtensions": true,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./*"]
    },
    "lib": ["ESNext"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "exclude": ["scripts", "**/__tests__/**"]
}
