{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"includes": ["**/*.ts", "**/*.tsx", "!@girs/**"]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"style": {
				"noExcessiveLinesPerFile": {
					"level": "error",
					"options": {
						"maxLines": 600,
						"skipBlankLines": true
					}
				}
			}
		}
	},
	"assist": {
		"enabled": false
	},
	"overrides": [
		{
			"includes": ["components/calendar-widget.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noExcessiveLinesPerFile": {
							"level": "error",
							"options": {
								"maxLines": 1400,
								"skipBlankLines": true
							}
						}
					}
				}
			}
		},
		{
			"includes": ["services/app-icons.ts"],
			"linter": {
				"rules": {
					"style": {
						"noExcessiveLinesPerFile": {
							"level": "error",
							"options": {
								"maxLines": 900,
								"skipBlankLines": true
							}
						}
					}
				}
			}
		}
	]
}
