# shellcheck shell=bash

devenv_export="$(direnv_layout_dir)/devenv-export.sh"
devenv_inputs=(
  .envrc
  devenv.nix
  devenv.yaml
  devenv.lock
  devenv.local.nix
  devenv.local.yaml
  lefthook.yml
  "$HOME/.direnvrc"
  "$HOME/.config/direnv/direnvrc"
)

# Devenv records every Nix input it evaluated, including local overlays and .env.
if [[ -f .devenv/input-paths.txt ]]; then
  mapfile -t devenv_evaluated_inputs < .devenv/input-paths.txt
  devenv_inputs+=("${devenv_evaluated_inputs[@]}")
fi

watch_file "${devenv_inputs[@]}"

if [[ ":${DIRENV_ACTIVE-}:" != *":$PWD:"* ]]; then
  export DIRENV_ACTIVE="$PWD${DIRENV_ACTIVE:+:$DIRENV_ACTIVE}"
fi
export DEVENV_DIRENVRC_VERSION=2
export DEVENV_DIRENVRC_ROLLING_UPGRADE=1

for devenv_input in "${devenv_inputs[@]}"; do
  if [[ ! -f "$devenv_export" ]] || [[ "$devenv_input" -nt "$devenv_export" ]]; then
    devenv_export_tmp="$(mktemp "$devenv_export.XXXXXX")"
    # Rebuild only after a declared input changes; cached exports keep directory entry fast.
    if ! _DEVENV_CALLER=direnv devenv --no-tui direnv-export > "$devenv_export_tmp"; then
      rm -f "$devenv_export_tmp"
      log_error "failed to refresh the devenv environment"
      exit 1
    fi
    mv "$devenv_export_tmp" "$devenv_export"
    break
  fi
done

# shellcheck disable=SC1090 # The export is regenerated from the watched Devenv inputs.
source "$devenv_export"
