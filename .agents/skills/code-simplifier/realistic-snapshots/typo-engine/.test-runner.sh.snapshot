#!/bin/sh
set -eu
root=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
export XDG_DATA_HOME="$root/.test-deps/xdg-data"
export XDG_CONFIG_HOME="$root/.test-deps/xdg-config"
export XDG_STATE_HOME="$root/.test-deps/xdg-state"
export XDG_CACHE_HOME="$root/.test-deps/xdg-cache"
runtime="$HOME/.code-simplifier-nvim-runtime"
mkdir -p "$runtime"
cleanup() {
  rm -rf "$runtime"
}
trap cleanup EXIT INT TERM
export NVIM_LOG_FILE="$runtime/nvim.log"
bun test ./.config/opencode/plugins/prompt-enhancements/__tests__/typo-engine.test.ts
