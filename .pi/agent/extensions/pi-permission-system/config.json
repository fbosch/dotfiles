{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/pi-permission-system-v29.0.0/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "doublePressToConfirm": false,
  "authorizerChain": [
    "session-yolo"
  ],
  "piInfrastructureReadPaths": [
    "~/.agents/skills/*",
    "~/dotfiles/.agents/skills/*",
    "/nix/store",
    "/tmp/pi-clipboard-*",
    "/home/fbb/Pictures/screenshots"
  ],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.ENV": "deny",
      "*.Env": "deny",
      "*.envrc": "deny",
      "*.envrc.*": "deny",
      "*/.direnv/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.git-credentials": "deny",
      "~/.config/git/credentials": "deny",
      "~/.pypirc": "deny",
      "~/.gem/credentials": "deny",
      "~/.cargo/credentials": "deny",
      "~/.cargo/credentials.toml": "deny",
      "~/.terraform.d/credentials.tfrc.json": "deny",
      "~/.config/gcloud/application_default_credentials.json": "deny",
      "~/.azure/*": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.config/glab-cli/config.yml": "deny",
      "~/.codex/auth.json": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/dotfiles/.pi/agent/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny"
    },
    "path_write": {
      "*/.pi/agent/extensions/pi-permission-system/config.json": "ask",
      "*/.pi/extensions/pi-permission-system/config.json": "ask",
      "*/.pi/agent/settings.json": "ask",
      "*/.pi/settings.json": "ask",
      "*/.pi/agent/mcp.json": "ask",
      "*/.pi/mcp.json": "ask",
      "*/.pi/agent/extensions/yolo.ts": "ask",
      "*/.pi/agent/agents/*": "ask",
      "*/.pi/agents/*": "ask"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "fffind": "allow",
    "ffgrep": "allow",
    "list_symbols": "allow",
    "find_definition": "allow",
    "find_callers": "allow",
    "get_symbol_body": "allow",
    "find_callees": "allow",
    "lsp": "allow",
    "git_diff": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "read_session": "allow",
    "hypr_window_screenshot": "allow",
    "ask_user_question": "allow",
    "todo": "allow",
    "just_tools": "allow",
    "subagent": "allow",
    "get_subagent_result": "allow",
    "steer_subagent": "allow",
    "worktrunk": "ask",
    "context7_resolve-library-id": "allow",
    "context7_get-library-docs": "allow",
    "ast-grep_ast-grep": "allow",
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow",
      "mcp_connect": "allow",
      "context7:*": "allow",
      "context7_*": "allow",
      "ast-grep:*": "allow",
      "ast-grep_*": "allow"
    },
    "bash": {
      "*": "ask",
      "set -o pipefail": "allow",
      "set -euo pipefail": "allow",
      "pwd": "allow",
      "true": "allow",
      "false": "allow",
      "cd *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "stat *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "which *": "allow",
      "grep *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "git status": "allow",
      "git status --short": "allow",
      "git status --short -- *": "allow",
      "git status --porcelain": "allow",
      "git branch --show-current": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git log": "allow",
      "git log --oneline": "allow",
      "git diff": "allow",
      "git diff -- *": "allow",
      "git diff --check": "allow",
      "git diff --check -- *": "allow",
      "git diff --stat": "allow",
      "git diff --stat -- *": "allow",
      "git diff --cached": "allow",
      "git diff --cached -- *": "allow",
      "git diff --staged": "allow",
      "git diff --staged -- *": "allow",
      "git worktree list *": "allow",
      "git worktree prune --dry-run": "allow",
      "git clean -nd": "allow",
      "sudo *": "deny",
      "doas *": "deny",
      "pkexec *": "deny",
      "su *": "deny"
    },
    "skill": "allow",
    "external_directory_read": {
      "*": "ask",
      "~/.config/opencode/*": "allow",
      "/dev/shm/opencode-window-screenshots/*": "allow"
    },
    "external_directory_write": "ask"
  }
}
