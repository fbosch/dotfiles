{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.codex/auth.json": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "*.env.example": "allow"
    },
    "path_write": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.codex/auth.json": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "*.env.example": "ask"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "ask",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "rm -r *": "deny",
      "rm -rf *": "deny",
      "git reset --hard *": "deny",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow"
    },
    "skill": "allow",
    "external_directory": "ask"
  }
}
