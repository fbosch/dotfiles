{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/pi-permission-system-v29.0.0/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.ENV": "deny",
      "*.Env": "deny",
      "*.envrc": "deny",
      "*.envrc.*": "deny",
      "*/.direnv/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.git-credentials": "deny",
      "~/.config/git/credentials": "deny",
      "~/.pypirc": "deny",
      "~/.gem/credentials": "deny",
      "~/.cargo/credentials": "deny",
      "~/.cargo/credentials.toml": "deny",
      "~/.terraform.d/credentials.tfrc.json": "deny",
      "~/.config/gcloud/application_default_credentials.json": "deny",
      "~/.azure/*": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.config/glab-cli/config.yml": "deny",
      "~/.codex/auth.json": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny"
    },
    "path_write": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.ENV": "deny",
      "*.Env": "deny",
      "*.envrc": "deny",
      "*.envrc.*": "deny",
      "*/.direnv/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.git-credentials": "deny",
      "~/.config/git/credentials": "deny",
      "~/.pypirc": "deny",
      "~/.gem/credentials": "deny",
      "~/.cargo/credentials": "deny",
      "~/.cargo/credentials.toml": "deny",
      "~/.terraform.d/credentials.tfrc.json": "deny",
      "~/.config/gcloud/application_default_credentials.json": "deny",
      "~/.azure/*": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.config/glab-cli/config.yml": "deny",
      "~/.codex/auth.json": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "ask",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "/bin/rm *": "deny",
      "/usr/bin/rm *": "deny",
      "* rm *": "deny",
      "git reset *": "deny",
      "git * reset *": "deny"
    },
    "skill": "allow",
    "external_directory": "ask"
  }
}
