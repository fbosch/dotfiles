{
  "autoEnableCodemode": false,
  "mcpServers": {
    "github": {
      "command": "gh",
      "args": [
        "mcp"
      ],
      "timeout": 30,
      "exposure": "deferred"
    },
    "context7": {
      "command": "podman",
      "args": [
        "run",
        "-i",
        "--rm",
        "--read-only",
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges",
        "-e",
        "MCP_TRANSPORT=stdio",
        "docker.io/mcp/context7@sha256:1174e6a29634a83b2be93ac1fefabf63265f498c02c72201fe3464e687dd8836"
      ],
      "timeout": 30,
      "exposure": "deferred"
    },
    "serena": {
      "command": "~/.pi/agent/mcp-launchers/serena",
      "args": [],
      "timeout": 30,
      "exposure": "deferred"
    },
    "ast-grep": {
      "command": "~/.pi/agent/mcp-launchers/ast-grep",
      "args": [],
      "timeout": 30,
      "exposure": "deferred"
    },
    "chrome-devtools": {
      "command": "podman",
      "args": [
        "run",
        "-i",
        "--rm",
        "--init",
        "--read-only",
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges",
        "--tmpfs",
        "/tmp:rw,nosuid,nodev,size=1g",
        "--tmpfs",
        "/root/.npm:rw,nosuid,nodev,size=256m",
        "-e",
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS=true",
        "-e",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS=true",
        "mcr.microsoft.com/playwright@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--executable-path=/ms-playwright/chromium-1243/chrome-linux64/chrome",
        "--chrome-arg=--no-sandbox"
      ],
      "timeout": 30,
      "exposure": "deferred"
    },
    "firefox-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "@mozilla/firefox-devtools-mcp@0.10.4",
        "--connect-existing",
        "--marionette-port",
        "2828",
        "--tools",
        "pages",
        "snapshot",
        "input",
        "screenshot",
        "script"
      ],
      "timeout": 30,
      "exposure": "deferred"
    },
    "shared-todo": {
      "url": "http://192.168.1.46:8092/mcp",
      "timeout": 30,
      "exposure": "deferred"
    }
  }
}
