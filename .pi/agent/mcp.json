{
  "autoEnableCodemode": false,
  "mcpServers": {
    "github": {
      "command": "gh",
      "args": [
        "mcp"
      ],
      "timeout": 30,
      "exposure": "deferred"
    },
    "context7": {
      "command": "npx",
      "args": [
        "--yes",
        "@upstash/context7-mcp@4.2.0"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "npm_config_cache": "${HOME}/.cache/pi/npm"
      },
      "timeout": 30,
      "exposure": "deferred"
    },
    "serena": {
      "command": "uv",
      "args": [
        "run",
        "--no-config",
        "--no-project",
        "--python",
        "3.12",
        "--with",
        "git+https://github.com/oraios/serena@949a27ef1e5fda1a6e7b561e777bcece345c6ffd",
        "--",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--transport",
        "stdio",
        "--enable-web-dashboard",
        "False",
        "--open-web-dashboard",
        "False"
      ],
      "env": {
        "UV_CACHE_DIR": "${HOME}/.cache/pi/uv",
        "UV_PYTHON_INSTALL_DIR": "${HOME}/.cache/pi/uv-python",
        "UV_TOOL_DIR": "${HOME}/.cache/pi/uv-tools",
        "SERENA_HOME": "${HOME}/.cache/pi/serena"
      },
      "timeout": 30,
      "exposure": "deferred"
    },
    "ast-grep": {
      "command": "uv",
      "args": [
        "run",
        "--no-config",
        "--no-project",
        "--python",
        "3.13",
        "--with",
        "git+https://github.com/ast-grep/ast-grep-mcp@149e20d47bb7125fb0c1451feea2f48a98742034",
        "--",
        "ast-grep-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "UV_CACHE_DIR": "${HOME}/.cache/pi/uv",
        "UV_PYTHON_INSTALL_DIR": "${HOME}/.cache/pi/uv-python"
      },
      "timeout": 30,
      "exposure": "deferred"
    },
    "chrome-devtools": {
      "command": "sh",
      "args": [
        "-eu",
        "-c",
        "browser=$(command -v google-chrome || command -v chromium || command -v chromium-browser || true); if [ -n \"$browser\" ]; then set -- \"--executable-path=$browser\" \"$@\"; fi; exec npx --yes chrome-devtools-mcp@1.10.1 \"$@\"",
        "chrome-devtools-mcp",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "env": {
        "npm_config_cache": "${HOME}/.cache/pi/npm",
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "true",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "true"
      },
      "timeout": 30,
      "exposure": "deferred"
    },
    "firefox-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "@mozilla/firefox-devtools-mcp@0.10.4",
        "--connect-existing",
        "--marionette-port",
        "2828",
        "--tools",
        "pages",
        "snapshot",
        "input",
        "screenshot",
        "script"
      ],
      "timeout": 30,
      "exposure": "deferred"
    },
    "shared-todo": {
      "url": "http://192.168.1.46:8092/mcp",
      "timeout": 30,
      "exposure": "deferred"
    }
  }
}
