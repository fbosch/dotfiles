{
  "lastChangelogVersion": "0.85.1",
  "theme": "zenwritten-dark",
  "quietStartup": true,
  "references": {
    "dotfiles": {
      "path": "~/dotfiles",
      "description": "Personal dotfiles"
    },
    "nixos": {
      "path": "~/nixos",
      "description": "Personal NixOS configuration"
    },
    "obsidian": {
      "path": "/mnt/nas/FrederikDocs/Obsidian/Vault",
      "description": "Personal Obsidian vault"
    }
  },
  "extensions": [
    "+extensions/catastrophic-command-guard.ts"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "quickReplies": {
    "enabled": true
  },
  "hideThinkingBlock": true,
  "showFileChanges": false,
  "tuiMode": "fullscreen",
  "selectorOverlayWidth": 72,
  "selectorOverlayWidths": {
    "model": 100,
    "scoped-models": 120,
    "fork": 120,
    "tree": 120,
    "session": 120
  },
  "fullscreenExitOutput": "resume-hint",
  "terminal": {
    "imageWidthCells": 80
  },
  "npmCommand": [
    "bash",
    "-c",
    "exec bun --no-install \"${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/lib/pi-npm.ts\" \"$@\"",
    "pi-npm"
  ],
  "compactionModel": {
    "model": "openai-codex/gpt-5.6-luna",
    "thinkingLevel": "low",
    "reasons": [
      "manual",
      "threshold",
      "overflow"
    ]
  },
  "commitMessageModel": {
    "model": "openai-codex/gpt-5.6-luna-fast",
    "thinkingLevel": "off"
  },
  "charts": {
    "fontFamily": "JetBrainsMono NF",
    "fontSize": 14
  },
  "toolDiscovery": {
    "deferredToolPrefixes": [
      "chart_",
      "figma_",
      "serena_",
      "context7_",
      "ast-grep_",
      "mcp__"
    ]
  },
  "packages": [
    "npm:pi-hashline-edit-pro@4.3.2",
    "npm:pi-codex-goal",
    "npm:pi-context-view@0.5.2",
    "npm:pi-mcp-adapter@2.32.1",
    "npm:pi-compaction-model@0.1.0",
    "npm:@ff-labs/pi-fff@0.10.6",
    "npm:@gotgenes/pi-subagents",
    "npm:pi-web-access",
    "npm:pi-lens@4.1.6"
  ],
  "autocompleteMaxVisible": 10,
  "editorPaddingX": 0,
  "skillTweaks": {
    "disableModelInvocation": [
      "grilling",
      "herdr",
      "skill-creator",
      "codebase-design",
      "improve-codebase-architecture",
      "grill-me"
    ],
    "modelInvocationAgents": {
      "ascii-visualizer": [
        "visualizer"
      ],
      "mermaid-diagrams": [
        "visualizer"
      ]
    }
  },
  "editPreviews": true,
  "syntaxTheme": "Zenwritten Dark",
  "modes": {
    "build": {
      "model": "openai-codex/gpt-5.6-luna-fast",
      "prompt": "./prompts/build.txt",
      "thinkingLevel": "xhigh",
      "color": "#66A5AD"
    },
    "plan": {
      "model": "openai-codex/gpt-5.6-sol",
      "prompt": "./prompts/plan.txt",
      "thinkingLevel": "high",
      "color": "#B279A7",
      "allowedTools": [
        "read",
        "find",
        "grep",
        "ls",
        "skill",
        "fffind",
        "ffgrep",
        "ask_user_question"
      ]
    }
  }
}
