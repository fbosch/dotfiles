{
  "lastChangelogVersion": "1.4.0",
  "theme": "zenwritten-dark",
  "quietStartup": true,
  "references": {
    "dotfiles": {
      "path": "~/dotfiles",
      "description": "Personal dotfiles"
    },
    "nixos": {
      "path": "~/nixos",
      "description": "Personal NixOS configuration"
    },
    "obsidian": {
      "path": "/mnt/nas/FrederikDocs/Obsidian/Vault",
      "description": "Personal Obsidian vault"
    }
  },
  "extensions": [
    "+extensions/catastrophic-command-guard.ts",
    "-extensions/subagent-steering-notice.ts"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna-fast",
  "defaultThinkingLevel": "xhigh",
  "defaultTools": [
    "+codemode"
  ],
  "compactionModel": {
    "model": "openai-codex/gpt-6-luna",
    "thinkingLevel": "xhigh",
    "reasons": [
      "manual",
      "threshold",
      "overflow"
    ]
  },
  "quickReplies": {
    "enabled": true
  },
  "hideThinkingBlock": false,
  "showFileChanges": false,
  "tuiMode": "fullscreen",
  "selectorOverlayWidth": 72,
  "selectorOverlayWidths": {
    "model": 100,
    "scoped-models": 120,
    "fork": 120,
    "tree": 120,
    "session": 120
  },
  "fullscreenExitOutput": "resume-hint",
  "terminal": {
    "imageWidthCells": 80
  },
  "shellPath": "/run/current-system/sw/bin/bash",
  "npmCommand": [
    "bash",
    "-c",
    "exec bun --no-install \"${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/lib/pi-npm.ts\" \"$@\"",
    "pi-npm"
  ],
  "commitMessageModel": {
    "model": "openai-codex/gpt-6-luna-fast",
    "thinkingLevel": "off"
  },
  "autoSessionTitle": {
    "model": "openai-codex/gpt-6-luna",
    "thinkingLevel": "low"
  },
  "tasks": {
    "icons": {
      "pending": "□",
      "in_progress": "■",
      "completed": "✓"
    }
  },
  "charts": {
    "fontFamily": "JetBrainsMono NF",
    "fontSize": 14
  },
  "toolDiscovery": {
    "deferredToolPrefixes": [
      "lens_",
      "symbol_search",
      "module_report",
      "project_report",
      "read_symbol",
      "read_enclosing",
      "effective_config",
      "pi_lens_",
      "assess_subagent_checkpoint",
      "todo",
      "exec",
      "find_definition",
      "find_callers",
      "find_callees",
      "get_symbol_body",
      "list_symbols",
      "lsp",
      "worktrunk",
      "web_enable",
      "figma_",
      "web_search",
      "source_check",
      "fetch_content",
      "get_search_content",
      "temporal_candidates",
      "create_goal",
      "get_goal",
      "update_goal"
    ]
  },
  "classifier": {
    "enabled": true,
    "commandGuard": {
      "enabled": true,
      "mode": "confirm"
    },
    "providers": [
      {
        "provider": "openrouter",
        "model": "typesafe/jev-1.14"
      },
      {
        "provider": "openrouter",
        "model": "openai/gpt-6-luna-decisions"
      }
    ],
    "imageProviders": [
      {
        "provider": "openrouter",
        "model": "typesafe/jev-1.14"
      },
      {
        "provider": "openrouter",
        "model": "openai/gpt-6-luna-decisions"
      }
    ],
    "toolDiscovery": {
      "enabled": true,
      "timeoutMs": 2400
    },
    "skillSelection": {
      "enabled": true,
      "midTaskEnabled": false,
      "threshold": 0.72,
      "timeoutMs": 2400,
      "maxRecommendations": 3
    }
  },
  "packages": [
    "npm:pi-hashline-edit-pro@7.0.0",
    "npm:pi-codex-goal@latest",
    "npm:pi-context-view@0.7.2",
    "npm:@ff-labs/pi-fff@0.11.0",
    "npm:pi-web-access@0.44.0",
    "npm:pi-lens@4.4.4",
    "npm:pi-compaction-model@0.1.0",
    "npm:pi-codemode-compact@0.4.0"
  ],
  "autocompleteMaxVisible": 10,
  "editorPaddingX": 0,
  "skillTweaks": {
    "warmSkills": [
      "code-simplifier",
      "deprecation-and-migration",
      "diagnosing-bugs",
      "grill-skill",
      "mermaid-diagrams",
      "microinteractions",
      "pr-description",
      "security-and-hardening",
      "swarm",
      "ui-writing",
      "vercel-react-best-practices",
      "writing-clearly"
    ],
    "disableModelInvocation": [
      "grilling",
      "herdr",
      "skill-creator",
      "codebase-design",
      "improve-codebase-architecture",
      "grill-me"
    ],
    "modelInvocationAgents": {
      "ascii-visualizer": [
        "visualizer"
      ],
      "mermaid-diagrams": [
        "visualizer"
      ]
    }
  },
  "editPreviews": true,
  "syntaxTheme": "Zenwritten Dark"
}
