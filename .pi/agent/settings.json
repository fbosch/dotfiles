{
  "lastChangelogVersion": "0.85.1",
  "theme": "zenwritten-dark",
  "extensions": [
    "!extensions/**",
    "+extensions/ask-user-question.ts",
    "+extensions/auth-profiles/index.ts",
    "+extensions/code-blocks/index.ts",
    "+extensions/code-mode/index.ts",
    "+extensions/command-aliases.ts",
    "+extensions/command-palette/index.ts",
    "+extensions/compaction-customization/index.ts",
    "+extensions/context-view-startup.ts",
    "+extensions/delta/index.ts",
    "+extensions/direnv/index.ts",
    "+extensions/file-changes/index.ts",
    "+extensions/formatter/index.ts",
    "+extensions/handoff/index.ts",
    "+extensions/herdr/index.ts",
    "+extensions/herdr-agent-state.ts",
    "+extensions/hyprland/index.ts",
    "+extensions/instruction-fragments.ts",
    "+extensions/just-tools/index.ts",
    "+extensions/lsp/index.ts",
    "+extensions/mcp-approval.ts",
    "+extensions/mentions/index.ts",
    "+extensions/neovim/index.ts",
    "+extensions/openai-capabilities.ts",
    "+extensions/pi-comma/index.ts",
    "+extensions/plan-mode.ts",
    "+extensions/prompt-ui/index.ts",
    "+extensions/quick-replies/index.ts",
    "+extensions/routed-prompts.ts",
    "+extensions/startup-header/index.ts",
    "+extensions/tool-discovery/index.ts",
    "+extensions/toon/index.ts",
    "+extensions/tree-sitter/index.ts",
    "+extensions/typo-abolish/index.ts",
    "+extensions/webfetch/index.ts",
    "+extensions/websearch.ts",
    "+extensions/yolo.ts"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "quickReplies": {
    "enabled": true
  },
  "hideThinkingBlock": false,
  "showFileChanges": false,
  "tuiMode": "fullscreen",
  "selectorOverlayWidth": 72,
  "selectorOverlayWidths": {
    "model": 100,
    "scoped-models": 120,
    "fork": 120,
    "tree": 120,
    "session": 120
  },
  "fullscreenExitOutput": "resume-hint",
  "npmCommand": [
    "bash",
    "-c",
    "exec bun --no-install \"${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/lib/pi-npm.ts\" \"$@\"",
    "pi-npm"
  ],
  "compaction": {
    "threshold": 0.25,
    "keepRecentPercent": 0.25
  },
  "compactionModel": {
    "model": "openai-codex/gpt-5.6-luna",
    "thinkingLevel": "low",
    "reasons": [
      "manual",
      "threshold",
      "overflow"
    ]
  },
  "commitMessageModel": {
    "model": "openai-codex/gpt-5.6-luna-fast",
    "thinkingLevel": "off"
  },
  "packages": [
    "npm:@gotgenes/pi-permission-system@31.1.1",
    "npm:@ff-labs/pi-fff@0.10.6",
    "npm:pi-compaction-model@0.1.0",
    "npm:pi-auto-session-name@0.1.1",
    {
      "source": "npm:pi-mcp-adapter@2.32.1",
      "skills": []
    },
    "npm:@gotgenes/pi-subagents@21.4.2",
    "npm:pi-context-view@0.5.0",
    "npm:@juicesharp/rpiv-todo@2.9.0",
    "npm:@narumitw/pi-btw@0.57.0",
    "npm:pi-worktrunk@0.8.0",
    "npm:pi-mono-figma@0.2.2",
    "npm:pi-hashline-edit-pro@3.0.4",
    "npm:@liborw/pi-startup-time"
  ],
  "autocompleteMaxVisible": 10,
  "editorPaddingX": 0
}
