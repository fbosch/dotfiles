{
  "lastChangelogVersion": "0.87.1",
  "theme": "zenwritten-dark",
  "quietStartup": true,
  "references": {
    "dotfiles": {
      "path": "~/dotfiles",
      "description": "Personal dotfiles"
    },
    "nixos": {
      "path": "~/nixos",
      "description": "Personal NixOS configuration"
    },
    "obsidian": {
      "path": "/mnt/nas/FrederikDocs/Obsidian/Vault",
      "description": "Personal Obsidian vault"
    }
  },
  "extensions": [
    "+extensions/catastrophic-command-guard.ts"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-sol",
  "quickReplies": {
    "enabled": true
  },
  "hideThinkingBlock": true,
  "showFileChanges": false,
  "tuiMode": "fullscreen",
  "selectorOverlayWidth": 72,
  "selectorOverlayWidths": {
    "model": 100,
    "scoped-models": 120,
    "fork": 120,
    "tree": 120,
    "session": 120
  },
  "fullscreenExitOutput": "resume-hint",
  "terminal": {
    "imageWidthCells": 80
  },
  "npmCommand": [
    "bash",
    "-c",
    "exec bun --no-install \"${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/lib/pi-npm.ts\" \"$@\"",
    "pi-npm"
  ],
  "commitMessageModel": {
    "model": "openai-codex/gpt-6-luna-fast",
    "thinkingLevel": "off"
  },
  "autoSessionTitle": {
    "model": "openai-codex/gpt-6-luna-fast",
    "thinkingLevel": "low"
  },
  "charts": {
    "fontFamily": "JetBrainsMono NF",
    "fontSize": 14
  },
  "toolDiscovery": {
    "deferredToolPrefixes": [
      "chart_",
      "figma_",
      "serena_",
      "context7_",
      "ast-grep_",
      "mcp__",
      "browser_",
      "web_search",
      "source_check",
      "fetch_content",
      "get_search_content",
      "temporal_candidates",
      "create_goal",
      "get_goal",
      "update_goal"
    ]
  },
  "jev": {
    "toolDiscovery": {
      "enabled": true,
      "timeoutMs": 2400
    },
    "skillSelection": {
      "enabled": true,
      "threshold": 0.72,
      "timeoutMs": 2400,
      "maxRecommendations": 3
    },
    "recommendAgent": {
      "enabled": true
    },
    "compaction": {
      "enabled": true,
      "summaryModel": "openai-codex/gpt-6-luna"
    }
  },
  "packages": [
    "npm:pi-hashline-edit-pro@4.3.5",
    "npm:pi-codex-goal@0.3.0",
    "npm:pi-context-view@0.5.2",
    "npm:pi-mcp-client@0.8.0",
    "npm:@ff-labs/pi-fff@0.10.6",
    "npm:@gotgenes/pi-subagents@21.7.1",
    "npm:pi-web-access@0.29.0",
    "npm:pi-lens@4.1.6",
    "npm:@juicesharp/rpiv-todo@2.10.1"
  ],
  "autocompleteMaxVisible": 10,
  "editorPaddingX": 0,
  "skillTweaks": {
    "disableModelInvocation": [
      "grilling",
      "herdr",
      "skill-creator",
      "codebase-design",
      "improve-codebase-architecture",
      "grill-me"
    ],
    "modelInvocationAgents": {
      "ascii-visualizer": [
        "visualizer"
      ],
      "mermaid-diagrams": [
        "visualizer"
      ]
    }
  },
  "editPreviews": true,
  "syntaxTheme": "Zenwritten Dark",
  "modes": {
    "build": {
      "model": "openai-codex/gpt-6-luna-fast",
      "prompt": "./prompts/build.txt",
      "thinkingLevel": "xhigh",
      "color": "#66A5AD"
    },
    "plan": {
      "model": "openai-codex/gpt-6-sol",
      "prompt": "./prompts/plan.txt",
      "thinkingLevel": "high",
      "color": "#B279A7",
      "allowedTools": [
        "read",
        "find",
        "grep",
        "ls",
        "skill",
        "fffind",
        "ffgrep",
        "ask_user_question"
      ]
    }
  }
}