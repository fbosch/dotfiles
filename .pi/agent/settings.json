{
  "lastChangelogVersion": "0.84.4",
  "theme": "zenwritten-dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna-fast",
  "hideThinkingBlock": true,
  "tuiMode": "fullscreen",
  "selectorOverlayWidth": 72,
  "selectorOverlayWidths": {
    "model": 100,
    "scoped-models": 120,
    "fork": 120,
    "tree": 120,
    "session": 120
  },
  "fullscreenExitOutput": "resume-hint",
  "npmCommand": [
    "npm",
    "--save-exact"
  ],
  "compactionModel": {
    "model": "openai-codex/gpt-5.6-luna-fast",
    "thinkingLevel": "low",
    "reasons": [
      "manual",
      "threshold",
      "overflow"
    ]
  },
  "packages": [
    "npm:@gotgenes/pi-permission-system@29.0.0",
    "npm:@ff-labs/pi-fff@0.10.6",
    "npm:pi-compaction-model@0.1.0",
    "npm:pi-auto-session-name@0.1.1",
    {
      "source": "npm:pi-mcp-adapter@2.31.0",
      "skills": []
    },
    "npm:@gotgenes/pi-subagents@21.0.3",
    "npm:pi-context-view@0.5.0",
    "npm:@juicesharp/rpiv-todo@2.8.0"
  ],
  "autocompleteMaxVisible": 10,
  "editorPaddingX": 0,
  "formatter": {
    "timeoutMs": 30000,
    "rules": {
      "web": {
        "mode": "first_available",
        "files": {
          "extensions": [
            ".css",
            ".html",
            ".js",
            ".jsx",
            ".json",
            ".jsonc",
            ".ts",
            ".tsx"
          ]
        },
        "commands": [
          {
            "command": "biome",
            "args": [
              "format",
              "--write",
              "$FILE"
            ],
            "requireRootMarker": true,
            "rootMarkers": [
              "biome.json",
              "biome.jsonc"
            ]
          },
          {
            "command": "prettier",
            "args": [
              "--write",
              "$FILE"
            ]
          }
        ]
      },
      "markdown": {
        "mode": "pipeline",
        "files": {
          "extensions": [
            ".md",
            ".yaml",
            ".yml"
          ]
        },
        "commands": [
          {
            "command": "prettier",
            "args": [
              "--write",
              "$FILE"
            ]
          }
        ]
      },
      "mdx": {
        "mode": "pipeline",
        "files": {
          "extensions": [
            ".mdx"
          ]
        },
        "commands": [
          {
            "command": "prettier",
            "args": [
              "--write",
              "$FILE"
            ]
          }
        ]
      },
      "fish": {
        "mode": "pipeline",
        "files": {
          "extensions": [
            ".fish"
          ]
        },
        "commands": [
          {
            "command": "fish_indent",
            "args": [
              "--write",
              "$FILE"
            ]
          }
        ]
      },
      "lua": {
        "mode": "pipeline",
        "files": {
          "extensions": [
            ".lua"
          ]
        },
        "commands": [
          {
            "command": "stylua",
            "args": [
              "--search-parent-directories",
              "--respect-ignores",
              "$FILE"
            ]
          }
        ]
      },
      "nix": {
        "mode": "pipeline",
        "files": {
          "extensions": [
            ".nix"
          ]
        },
        "commands": [
          {
            "command": "nixfmt",
            "args": [
              "$FILE"
            ]
          }
        ]
      }
    }
  }
}
