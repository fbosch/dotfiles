{
  "timeouts": {
    "startupMs": 10000,
    "requestMs": 10000,
    "diagnosticsMs": 5000,
    "shutdownMs": 2000
  },
  "servers": {
    "bashls": {
      "command": "bash-language-server",
      "args": [
        "start"
      ],
      "languages": [
        {
          "languageId": "shellscript",
          "extensions": [
            ".sh",
            ".bash"
          ],
          "fileNames": [
            ".bashrc",
            ".bash_profile",
            ".bash_login",
            ".bash_logout",
            ".profile"
          ]
        }
      ],
      "rootMarkers": [
        ".git"
      ],
      "settings": {
        "bashIde": {
          "shellcheckPath": "shellcheck",
          "shellcheckExternalSources": true
        }
      }
    },
    "biome": {
      "command": "biome",
      "args": [
        "lsp-proxy"
      ],
      "languages": [
        {
          "languageId": "javascript",
          "extensions": [
            ".js"
          ]
        },
        {
          "languageId": "javascriptreact",
          "extensions": [
            ".jsx"
          ]
        },
        {
          "languageId": "typescript",
          "extensions": [
            ".ts"
          ]
        },
        {
          "languageId": "typescriptreact",
          "extensions": [
            ".tsx"
          ]
        },
        {
          "languageId": "json",
          "extensions": [
            ".json"
          ]
        },
        {
          "languageId": "jsonc",
          "extensions": [
            ".jsonc"
          ]
        },
        {
          "languageId": "css",
          "extensions": [
            ".css"
          ]
        },
        {
          "languageId": "html",
          "extensions": [
            ".html"
          ]
        }
      ],
      "rootMarkers": [
        "biome.json",
        "biome.jsonc"
      ]
    },
    "cssls": {
      "command": "vscode-css-language-server",
      "args": [
        "--stdio"
      ],
      "languages": [
        {
          "languageId": "css",
          "extensions": [
            ".css"
          ]
        },
        {
          "languageId": "scss",
          "extensions": [
            ".scss"
          ]
        },
        {
          "languageId": "less",
          "extensions": [
            ".less"
          ]
        }
      ],
      "rootMarkers": [
        "package.json",
        ".git"
      ],
      "initializationOptions": {
        "provideFormatter": false
      },
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore"
          }
        }
      }
    },
    "eslint": {
      "command": "vscode-eslint-language-server",
      "args": [
        "--stdio"
      ],
      "languages": [
        {
          "languageId": "javascript",
          "extensions": [
            ".js"
          ]
        },
        {
          "languageId": "javascriptreact",
          "extensions": [
            ".jsx"
          ]
        },
        {
          "languageId": "typescript",
          "extensions": [
            ".ts"
          ]
        },
        {
          "languageId": "typescriptreact",
          "extensions": [
            ".tsx"
          ]
        }
      ],
      "rootMarkers": [
        "eslint.config.js",
        "eslint.config.mjs",
        "eslint.config.cjs",
        "eslint.config.ts",
        "eslint.config.mts",
        "eslint.config.cts",
        ".eslintrc",
        ".eslintrc.js",
        ".eslintrc.cjs",
        ".eslintrc.yaml",
        ".eslintrc.yml",
        ".eslintrc.json"
      ],
      "settings": {
        "validate": "on",
        "run": "onSave",
        "workingDirectory": {
          "mode": "auto"
        },
        "format": false
      }
    },
    "fallow": {
      "command": "fallow-lsp",
      "languages": [
        {
          "languageId": "javascript",
          "extensions": [
            ".js"
          ]
        },
        {
          "languageId": "javascriptreact",
          "extensions": [
            ".jsx"
          ]
        },
        {
          "languageId": "typescript",
          "extensions": [
            ".ts"
          ]
        },
        {
          "languageId": "typescriptreact",
          "extensions": [
            ".tsx"
          ]
        }
      ],
      "rootMarkers": [
        ".fallowrc.json",
        ".fallowrc.jsonc",
        "fallow.toml",
        ".fallow.toml"
      ]
    },
    "html": {
      "command": "vscode-html-language-server",
      "args": [
        "--stdio"
      ],
      "languages": [
        {
          "languageId": "html",
          "extensions": [
            ".html"
          ]
        }
      ],
      "rootMarkers": [
        "package.json",
        ".git"
      ],
      "initializationOptions": {
        "provideFormatter": false,
        "embeddedLanguages": {
          "css": true,
          "javascript": true
        }
      }
    },
    "lua_ls": {
      "command": "lua-language-server",
      "languages": [
        {
          "languageId": "lua",
          "extensions": [
            ".lua"
          ]
        }
      ],
      "rootMarkers": [
        ".luarc.json",
        ".luarc.jsonc",
        ".git"
      ],
      "settings": {
        "Lua": {
          "runtime": {
            "version": "LuaJIT"
          },
          "diagnostics": {
            "globals": [
              "vim",
              "use"
            ]
          },
          "workspace": {
            "checkThirdParty": false
          }
        }
      }
    },
    "marksman": {
      "command": "marksman",
      "args": [
        "server"
      ],
      "languages": [
        {
          "languageId": "markdown",
          "extensions": [
            ".md"
          ]
        },
        {
          "languageId": "markdown.mdx",
          "extensions": [
            ".mdx"
          ]
        }
      ],
      "rootMarkers": [
        ".marksman.toml",
        ".git"
      ]
    },
    "nil": {
      "command": "nil",
      "languages": [
        {
          "languageId": "nix",
          "extensions": [
            ".nix"
          ]
        }
      ],
      "rootMarkers": [
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "shell.nix"
      ]
    },
    "stylelint": {
      "command": "stylelint-lsp",
      "args": [
        "--stdio"
      ],
      "languages": [
        {
          "languageId": "css",
          "extensions": [
            ".css"
          ]
        },
        {
          "languageId": "scss",
          "extensions": [
            ".scss"
          ]
        },
        {
          "languageId": "less",
          "extensions": [
            ".less"
          ]
        }
      ],
      "rootMarkers": [
        ".stylelintrc",
        ".stylelintrc.json",
        ".stylelintrc.yaml",
        ".stylelintrc.yml",
        ".stylelintrc.js",
        ".stylelintrc.cjs",
        ".stylelintrc.mjs",
        "stylelint.config.js",
        "stylelint.config.cjs",
        "stylelint.config.mjs"
      ],
      "settings": {
        "stylelintplus": {
          "enable": true,
          "validateOnSave": true,
          "validateOnType": true
        }
      }
    },
    "tsgo": {
      "command": "tsgo",
      "args": [
        "--lsp",
        "--stdio"
      ],
      "languages": [
        {
          "languageId": "javascript",
          "extensions": [
            ".js"
          ]
        },
        {
          "languageId": "javascriptreact",
          "extensions": [
            ".jsx"
          ]
        },
        {
          "languageId": "typescript",
          "extensions": [
            ".ts"
          ]
        },
        {
          "languageId": "typescriptreact",
          "extensions": [
            ".tsx"
          ]
        }
      ],
      "rootMarkers": [
        "tsconfig.json",
        "jsconfig.json",
        "package.json",
        "pnpm-lock.yaml",
        "yarn.lock",
        "package-lock.json",
        "bun.lock",
        ".git"
      ]
    }
  }
}
