+        if (flag === "--") break;
+      }
+    } else {
+      if (classifyWrapperWords(current) !== "indirection") break;
+      start = innerCommandIndex(current);
+    }
+    if (start < 1 || start >= current.length) break;
+    current = rebase(current, start, execTerminatorIndex(current, start));
+    layers.push(current);
+  }
+  return layers;
+}
