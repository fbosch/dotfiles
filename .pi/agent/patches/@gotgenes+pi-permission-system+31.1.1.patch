+++ b/node_modules/@gotgenes/pi-permission-system/src/access-intent/bash/wrapper-analysis.ts
@@ -127,0 +128,27 @@ export function isTransparentWrapper(
+// Denial-only inspection keeps every wrapper layer, including a privileged
+// wrapper between two otherwise harmless prefixes. These candidates never grant access.
+export function commandLayersOf(words: readonly CommandWord[]): readonly (readonly CommandWord[])[] {
+  const layers: (readonly CommandWord[])[] = [words];
+  let current = words;
+  for (let depth = 0; depth < 16; depth++) {
+    const name = wrapperName(current);
+    let start: number;
+    if (name === "command" || name === "builtin" || name === "exec" || name === "busybox" || name === "toybox") {
+      if (name === "command" && current.slice(1).some((word) => /^-[^-]*[vV]/.test(word.text))) break;
+      start = 1;
+      while (current[start]?.text.startsWith("-")) {
+        const flag = current[start].text;
+        start += name === "exec" && flag === "-a" ? 2 : 1;
+        if (flag === "--") break;
+      }
+    } else {
+      if (classifyWrapperWords(current) !== "indirection") break;
+      start = innerCommandIndex(current);
+    }
+    if (start < 1 || start >= current.length) break;
+    current = rebase(current, start, execTerminatorIndex(current, start));
+    layers.push(current);
+  }
+  return layers;
+}
+
