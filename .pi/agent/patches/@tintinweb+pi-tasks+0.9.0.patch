diff --git a/node_modules/@tintinweb/pi-tasks/src/session-history.ts b/node_modules/@tintinweb/pi-tasks/src/session-history.ts
new file mode 100644
index 0000000..05a7680
--- /dev/null
+++ b/node_modules/@tintinweb/pi-tasks/src/session-history.ts
@@ -0,0 +1,37 @@
+import type { TaskStoreData } from "./types.js";
+
+export const TASK_STATE_ENTRY_TYPE = "pi-tasks-state";
+
+function isTaskStoreData(value: unknown): value is TaskStoreData {
+  if (!value || typeof value !== "object") return false;
+  const data = value as Record<string, unknown>;
+  return typeof data.nextId === "number" && Number.isInteger(data.nextId) && data.nextId > 0 &&
+    Array.isArray(data.tasks) && data.tasks.every((task) =>
+      !!task && typeof task === "object" && typeof (task as Record<string, unknown>).id === "string"
+    );
+}
+
+function copyState(data: TaskStoreData): TaskStoreData {
+  return {
+    nextId: data.nextId,
+    tasks: data.tasks.map((task) => ({
+      ...structuredClone(task),
+      metadata: task.metadata && typeof task.metadata === "object" ? structuredClone(task.metadata) : {},
+      blocks: Array.isArray(task.blocks) ? [...task.blocks] : [],
+      blockedBy: Array.isArray(task.blockedBy) ? [...task.blockedBy] : [],
+    })),
+  };
+}
+
+/** Reconstruct the latest task snapshot on the active branch, ignoring sibling histories. */
+export function replayTaskState(ctx: { sessionManager: { getBranch(): Iterable<unknown> } }): TaskStoreData {
+  let state: TaskStoreData = { tasks: [], nextId: 1 };
+  for (const entry of ctx.sessionManager.getBranch()) {
+    if (!entry || typeof entry !== "object") continue;
+    const candidate = entry as Record<string, unknown>;
+    if (candidate.type !== "custom" || candidate.customType !== TASK_STATE_ENTRY_TYPE) continue;
+    if (!isTaskStoreData(candidate.data)) continue;
+    state = candidate.data;
+  }
+  return copyState(state);
+}
