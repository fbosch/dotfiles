{
  "extends": "./node_modules/.cache/pi-sdk/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "bun",
      "node"
    ]
  },
  "include": [
    "benchmarks/codex-prefix-compaction.ts",
    "benchmarks/context-prefix-comparison.ts",
    "benchmarks/__tests__/codex-prefix-compaction.test.ts",
    "benchmarks/__tests__/context-prefix-comparison.test.ts",
    "__tests__/**/*.ts",
    "extensions/**/*.ts",
    "lib/**/*.ts"
  ]
}
