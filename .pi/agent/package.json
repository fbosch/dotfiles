{
  "name": "pi-agent-config",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [],
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "audit": "fallow --only dead-code --fail-on-issues",
    "benchmark:startup": "bash benchmarks/startup.sh",
    "check": "bun run lint && bun run test && bun run typecheck && bun run audit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/bun": "1.4.0",
    "@types/node": "22.19.19",
    "fallow": "3.21.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "0.11.0",
    "@toon-format/toon": "2.1.0",
    "effect": "4.0.0-beta.107",
    "neovim": "5.4.0",
    "neverthrow": "8.2.0",
    "picocolors": "1.1.1",
    "ts-pattern": "5.9.0",
    "vscode-languageserver-protocol": "3.18.2",
    "web-tree-sitter": "0.26.10"
  }
}
